{
  "name": "fudan-svg-cli-lab1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OO SVG command-line editor for Lab1 Phase 1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "cli": "node --import tsx src/cli/Main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint src test",
    "demo": "node --import tsx src/cli/Main.ts < scripts/flowchart.cli",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "demo:typical": "node --import tsx src/cli/Main.ts < scripts/typical.cli",
    "demo:transforms": "node --import tsx src/cli/Main.ts < scripts/transforms.cli"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
