{
  "name": "fudan-svg-cli-lab1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OO SVG command-line editor for Lab1 Phase 1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "tsx src/cli/Main.ts",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint src test",
    "demo": "tsx src/cli/Main.ts < scripts/flowchart.cli",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  }
}
